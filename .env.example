# Supabase project settings (public client values only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_your_project_key

# Base URL used for email confirmation links.
# For local development use http://localhost:3000.
# In production, set this to your canonical HTTPS domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
